# MongoDB: use local container (default) or set your Atlas URI
MONGO_URI=mongodb://mongo:27017/canvaslite

# JWT secret (generate a strong random string for production)
JWT_SECRET=change-me-to-a-random-long-string

# Frontend API base URL. Use "/api" when frontend and backend share a domain.
REACT_APP_API_URL=/api

# Domain for Traefik routing (used in compose labels)
CANVASLITE_HOST=canvaslite.192.168.1.101.nip.io
